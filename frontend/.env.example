# Copy to .env.local. Validated when `next dev` or `next build` starts.

# Origin of the backend API; the /api/v1 prefix is added by the app.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Store WhatsApp number in international format, digits only (country, area and number).
NEXT_PUBLIC_WHATSAPP_NUMBER=5492622380159

# The same number as shown to customers.
NEXT_PUBLIC_WHATSAPP_DISPLAY=2622 38-0159

# Supabase, which serves the public product images (`supabase status` shows the local one).
NEXT_PUBLIC_STORAGE_URL=http://127.0.0.1:54321
