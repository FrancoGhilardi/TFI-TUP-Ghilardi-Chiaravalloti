# Copiar a .env y ajustar.
NODE_ENV=development
PORT=3001
# Origen permitido por CORS (frontend Next.js)
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API, used to read the client IP from
# X-Forwarded-For. 0 locally (the header is ignored); 1 behind the Render proxy.
# After deploying, check a real X-Forwarded-For: if it lists more proxy hops, raise this
# value, or every client would share one rate limit.
TRUST_PROXY=0

# Local Docker (Supabase CLI). Para Supabase remoto usar un archivo aparte (ENV_FILE=.env.supabase).
DATABASE_URL=postgresql://libreria_app:libreria_app@127.0.0.1:54322/postgres
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL_MODE=disable

# Supabase remoto (session pooler, puerto 5432):
# DATABASE_URL=postgresql://libreria_app.<project-ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Access token (JWT HS256). Production needs its own random secret of at least 32 characters,
# for example: openssl rand -base64 48. Values starting with dev-only- are rejected in production.
JWT_ACCESS_SECRET=dev-only-access-token-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
# Lifetime of the session kept in the refresh token cookie, between 1 and 30 days.
REFRESH_TOKEN_TTL_DAYS=7

# Mail delivery through Resend, required in production. Left blank, the mails are only
# written to the log, temporary password included, which is fine for local work only.
RESEND_API_KEY=
MAIL_FROM=

# Supabase Storage, where the product images are kept. Locally: the API of the Supabase CLI and
# its fixed demo service_role key, signed with the CLI default JWT secret, which only works
# against the local stack. In production, the project URL and its own service_role key
# (Settings > API); never commit a real one.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Never read by the app: the public anon key, the one anyone gets, which the e2e tests and
# pnpm storage:setup use to check the buckets stay closed to it. Locally, the fixed demo anon
# key of the CLI; for a Supabase project, its own anon key (Settings > API).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Initial admin seed only (pnpm db:seed-admin). Fill all three before running it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
